#!/usr/bin/make -f

# Ensure cargo is available
export CARGO_HOME := $(HOME)/.cargo
export PATH := $(CARGO_HOME)/bin:$(PATH)

%:
	dh $@

override_dh_auto_build:
	./scripts/prepare-icons.sh
	$(HOME)/.cargo/bin/cargo build --release

# Disable auto-test because dh_auto_test calls Makefile test target
# which uses $(CARGO_BIN) that may not have .cargo/env loaded
override_dh_auto_test:
	@echo "Skipping dh_auto_test (GTK tests require display)"

override_dh_auto_install:
	install -D -m 0755 target/release/yandex-messenger debian/yandex-messenger-native/usr/bin/yandex-messenger
	install -D -m 0644 yandex-messenger.desktop debian/yandex-messenger-native/usr/share/applications/yandex-messenger.desktop
	install -D -m 0644 icons/hicolor/scalable/apps/yandex-messenger.svg debian/yandex-messenger-native/usr/share/icons/hicolor/scalable/apps/yandex-messenger.svg
	@for size in 16 24 32 48 64 128 256 512; do \
		if [ -f icons/hicolor/$${size}x$${size}/apps/yandex-messenger.png ]; then \
			install -D -m 0644 icons/hicolor/$${size}x$${size}/apps/yandex-messenger.png \
				debian/yandex-messenger-native/usr/share/icons/hicolor/$${size}x$${size}/apps/yandex-messenger.png; \
		fi; \
	done
	install -D -m 0644 yandex-messenger.1 debian/yandex-messenger-native/usr/share/man/man1/yandex-messenger.1
	install -D -m 0644 src/ui/theme.css debian/yandex-messenger-native/usr/share/yandex-messenger-native/theme.css
	install -D -m 0644 src/ui/theme-tokens-light.css debian/yandex-messenger-native/usr/share/yandex-messenger-native/theme-tokens-light.css
	install -D -m 0644 src/ui/theme-tokens-night.css debian/yandex-messenger-native/usr/share/yandex-messenger-native/theme-tokens-night.css
	@if [ -f icons/b2c_main_logo.png ]; then \
		install -D -m 0644 icons/b2c_main_logo.png debian/yandex-messenger-native/usr/share/yandex-messenger-native/b2c_main_logo.png; \
	fi

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_clean:
	$(HOME)/.cargo/bin/cargo clean
